#!/bin/sh
# Board tool for the agent and for Owner: list, show, add, update, done, sync.
# Runs as user mastan. Loads /etc/mastan-me/board.env when the caller has no token in env
# (the agent's child processes get a clean env on purpose; only the board token is loaded here).
set -eu
APP=/opt/mastan-me
[ -d "$APP/src" ] || APP=$(cd "$(dirname "$0")/.." && pwd)
NODE=/opt/mastan-me/runtime/node/bin/node
[ -x "$NODE" ] || NODE=$(command -v node)
if [ "$(id -u)" = "0" ]; then
  exec setpriv --reuid=mastan --regid=mastan --init-groups --reset-env \
    env HOME=/var/lib/mastan/home TZ=Asia/Riyadh PATH=/opt/mastan-me/bin:/usr/local/bin:/usr/bin:/bin "$0" "$@"
fi
if [ -z "${BOARD_WRITER_TOKEN:-}" ]; then
  if [ -r /etc/mastan-me/board.env ]; then set -a; . /etc/mastan-me/board.env; set +a; fi
fi
exec "$NODE" "$APP/src/board/cli.js" "$@"
