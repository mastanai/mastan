[Unit]
Description=Mastan Me fleet gate (commands require Owner's passkey)
Requires=mastan-fleet.socket
After=network-online.target

[Service]
Type=simple
User=mastan-ops
Group=mastan-ops
ExecStart=/opt/mastan-me/runtime/node/bin/node /opt/mastan-fleet/gate.mjs
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mastan-fleet-gate
ReadOnlyPaths=/var/lib/mastan-ops/ssh /opt/mastan-fleet /etc/mastan-fleet-gate
InaccessiblePaths=-/var/lib/mastan-me -/etc/mastan-me -/etc/mastan-fleet -/var/lib/mastan-fleet -/var/lib/mastan-gh -/etc/mastan-gh -/var/lib/mastan -/etc/mastan -/etc/mastan-content -/etc/mastan-mail
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=64
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mastan-fleet

[Install]
WantedBy=multi-user.target
